protocol Pug.Logger : Sendable {
  func debug(_ message: String)
  func error(_ message: String, error: (any Error)?)
  func warning(_ message: String, error: (any Error)?)
}

final class Pug.MemoryStorage : Pug.Storage, Sendable {
  init()
  func removeValue(forKey key: String)
  func setString(_ value: String, forKey key: String)
  func string(forKey key: String) -> String?
}

struct Pug.Options : Sendable {
  init(apiKey: String)
  var apiKey: String
  var autoInstallEvents: Bool
  var autoOpenCloseEvents: Bool
  var autoScreenViews: Bool
  var batchMaxQueueSize: Int
  var batchMaxSize: Int
  var batchMaxWait: TimeInterval
  var debug: Bool
  var defaultTrackingConsent: Pug.TrackingConsent
  var dryRun: Bool
  var endpoint: URL
  var logger: (any Pug.Logger)?
  var persistTrackingConsent: Bool
  var sessionIdleTimeout: TimeInterval
  var sessionMaxDuration: TimeInterval
  var storage: (any Pug.Storage)?
}

protocol Pug.Storage : Sendable {
  func removeValue(forKey key: String) throws
  func setString(_ value: String, forKey key: String) throws
  func string(forKey key: String) throws -> String?
}

