struct Pug.TrackOptions : Equatable, Hashable, Sendable {
  init(immediate: Bool = false, timestamp: Date? = nil)
  var immediate: Bool
  var timestamp: Date?
}

enum Pug.TrackingConsent : Equatable, Hashable, Sendable {
  case denied
  case granted
}
