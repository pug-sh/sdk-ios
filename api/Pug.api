enum Pug {
  static let track: Pug.TrackNamespace
  static var isConsentPending: Bool { get }
  static var isTrackingEnabled: Bool { get }
  static var trackingConsent: Pug.TrackingConsent? { get }
  static func destroy()
  static func flush()
  static func identify(_ externalId: String, traits: [String : Any]? = nil)
  static func initialize(projectId: String, options: Pug.Options) throws(Pug.ConfigurationError)
  static func optInTracking()
  static func optOutTracking()
  static func reset()
  static func rotateSession()
  static func screen(_ name: String)
  static func track(_ kind: String, properties: [String : Any]? = nil, options: Pug.TrackOptions? = nil)
  static func whenConsentReady(_ callback: @escaping @MainActor () -> Void)
}

struct Pug.ConfigurationError : CustomStringConvertible, Equatable, Error, Hashable, LocalizedError, Sendable {
  let message: String
  var description: String { get }
  var errorDescription: String? { get }
}

